# ====================================================================
# MilliyGram — Lokal ishga tushirish uchun muhit o'zgaruvchilari namunasi
# Ushbu fayldan ".env" nomi bilan nusxa oling:  cp .env.example .env
# (.env fayli .gitignore ro'yxatiga kiritilgan va GitHub'ga yuklanmaydi)
# ====================================================================

DB_URL=jdbc:postgresql://localhost:5432/mini_blog?currentSchema=public
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Birinchi (bosh) adminni yaratish uchun bir martalik kalit (kamida 24 belgi):
ADMIN_SETUP_TOKEN=replace_with_random_24_plus_char_token_123456
